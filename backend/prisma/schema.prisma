generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  PHARMACIST
  CASHIER
  CUSTOMER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  CREAM
  INJECTION
  DEVICE
  DROPS
  POWDER
  OTHER
}

enum UnitType {
  PIECE
  STRIP
  BOX
  DOZEN
  SUB_DOZEN
  CARTON
  BOTTLE
  PACK
}

enum SellingUnit {
  PIECE
  STRIP
  BOX
  DOZEN
  SUB_DOZEN
  CARTON
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  EXPIRED
  TRANSFER
}

enum PaymentMethod {
  CASH
  TELEBIRR
  EVC_PLUS
  ZAAD
  CBE_BIRR
  BANK
  CARD
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PAID
  PARTIAL
  PENDING
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          Int       @id @default(autoincrement())
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  email       String?   @unique
  password    String
  phone       String?
  gender      Gender?
  avatar      String?
  address     String?
  city        String?
  country     String?   @default("Ethiopia")
  role        Role      @default(CUSTOMER)
  isActive    Boolean   @default(true) @map("is_active")
  lastLogin   DateTime? @map("last_login")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sales               Sale[]
  purchases           Purchase[]
  inventoryMovements  InventoryMovement[]
  expenses            Expense[]
  prescriptionsReviewed Prescription[] @relation("reviewer")
  auditLogs           AuditLog[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  icon        String?
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  medicines   Medicine[]

  @@map("categories")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?
  city          String?
  balanceDue    Decimal   @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  medicines     Medicine[]
  purchases     Purchase[]

  @@map("suppliers")
}

model Medicine {
  id                    Int          @id @default(autoincrement())
  categoryId            Int          @map("category_id")
  supplierId            Int?         @map("supplier_id")
  name                  String
  slug                  String       @unique
  genericName           String?      @map("generic_name")
  barcode               String?      @unique
  sku                   String?      @unique
  description           String?      @db.Text
  manufacturer          String?
  dosage                String?
  strength              String?
  form                  MedicineForm @default(TABLET)
  purchasePrice         Decimal      @map("purchase_price") @db.Decimal(12, 2)
  retailPrice           Decimal      @map("retail_price") @db.Decimal(12, 2)
  wholesalePrice        Decimal?     @map("wholesale_price") @db.Decimal(12, 2)
  minimumPrice          Decimal?     @map("minimum_price") @db.Decimal(12, 2)
  taxPercent            Decimal      @default(0) @map("tax_percent") @db.Decimal(5, 2)
  discountPercent       Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  unitType              UnitType     @default(PIECE) @map("unit_type")
  piecesPerStrip        Int          @default(1) @map("pieces_per_strip")
  stripsPerBox          Int          @default(1) @map("strips_per_box")
  boxesPerDozen         Int          @default(12) @map("boxes_per_dozen")
  boxesPerCarton        Int          @default(1) @map("boxes_per_carton")
  stockQuantity         Int          @default(0) @map("stock_quantity")
  minimumStock          Int          @default(5) @map("minimum_stock")
  damagedStock          Int          @default(0) @map("damaged_stock")
  returnedStock         Int          @default(0) @map("returned_stock")
  batchNumber           String?      @map("batch_number")
  expiryDate            DateTime?    @map("expiry_date")
  imageUrl              String?      @map("image_url")
  prescriptionRequired  Boolean      @default(false) @map("prescription_required")
  featured              Boolean      @default(false)
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  category              Category     @relation(fields: [categoryId], references: [id])
  supplier              Supplier?    @relation(fields: [supplierId], references: [id])
  saleItems             SaleItem[]
  purchaseItems         PurchaseItem[]
  inventoryMovements    InventoryMovement[]

  @@map("medicines")
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  medicineId    Int          @map("medicine_id")
  movementType  MovementType @map("movement_type")
  quantity      Int
  previousStock Int          @map("previous_stock")
  newStock      Int          @map("new_stock")
  note          String?      @db.Text
  createdBy     Int?         @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  medicine      Medicine     @relation(fields: [medicineId], references: [id])
  user          User?        @relation(fields: [createdBy], references: [id])

  @@map("inventory_movements")
}

model Customer {
  id            Int       @id @default(autoincrement())
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone         String?   @unique
  email         String?
  address       String?   @db.Text
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  creditBalance Decimal   @default(0) @map("credit_balance") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  sales         Sale[]
  prescriptions Prescription[]

  @@map("customers")
}

model Sale {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique @map("invoice_no")
  customerId    Int?          @map("customer_id")
  cashierId     Int           @map("cashier_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal       @map("paid_amount") @db.Decimal(12, 2)
  changeAmount  Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  status        SaleStatus    @default(COMPLETED)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  customer      Customer?     @relation(fields: [customerId], references: [id])
  cashier       User          @relation(fields: [cashierId], references: [id])
  items         SaleItem[]

  @@map("sales")
}

model SaleItem {
  id            Int         @id @default(autoincrement())
  saleId        Int         @map("sale_id")
  medicineId    Int         @map("medicine_id")
  quantity      Decimal     @db.Decimal(12, 2)
  sellingUnit   SellingUnit @default(PIECE) @map("selling_unit")
  purchasePrice Decimal     @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal     @map("selling_price") @db.Decimal(12, 2)
  totalCost     Decimal     @map("total_cost") @db.Decimal(12, 2)
  totalPrice    Decimal     @map("total_price") @db.Decimal(12, 2)
  profit        Decimal     @default(0) @db.Decimal(12, 2)
  loss          Decimal     @default(0) @db.Decimal(12, 2)
  createdAt     DateTime    @default(now()) @map("created_at")

  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine      Medicine    @relation(fields: [medicineId], references: [id])

  @@map("sale_items")
}

model Purchase {
  id          Int            @id @default(autoincrement())
  supplierId  Int            @map("supplier_id")
  invoiceNo   String?        @map("invoice_no")
  totalAmount Decimal        @map("total_amount") @db.Decimal(12, 2)
  paidAmount  Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2)
  dueAmount   Decimal        @default(0) @map("due_amount") @db.Decimal(12, 2)
  status      PurchaseStatus @default(PENDING)
  createdBy   Int?           @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  creator     User?          @relation(fields: [createdBy], references: [id])
  items       PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id            Int      @id @default(autoincrement())
  purchaseId    Int      @map("purchase_id")
  medicineId    Int      @map("medicine_id")
  quantity      Int
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(12, 2)
  expiryDate    DateTime? @map("expiry_date")
  batchNumber   String?  @map("batch_number")
  createdAt     DateTime @default(now()) @map("created_at")

  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicineId], references: [id])

  @@map("purchase_items")
}

model Prescription {
  id          Int                @id @default(autoincrement())
  customerId  Int                @map("customer_id")
  imageUrl    String             @map("image_url")
  notes       String?            @db.Text
  status      PrescriptionStatus @default(PENDING)
  reviewedBy  Int?               @map("reviewed_by")
  reviewedAt  DateTime?          @map("reviewed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  customer    Customer           @relation(fields: [customerId], references: [id])
  reviewer    User?              @relation("reviewer", fields: [reviewedBy], references: [id])

  @@map("prescriptions")
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  category    String?
  note        String?  @db.Text
  expenseDate DateTime @map("expense_date")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  creator     User?    @relation(fields: [createdBy], references: [id])

  @@map("expenses")
}

model Setting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key")
  settingValue String?  @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String?
  tableName String?  @map("table_name")
  recordId  Int?     @map("record_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
